@model snakemvc.Models.RegisterViewModel
@{
    ViewData["Title"] = "Crear cuenta";
}

<section class="container auth-section">
    <div class="auth-card">
        <div class="auth-head">
            <span class="brand-icon" aria-hidden="true">S</span>
            <h1>Crea tu cuenta</h1>
            <p>Regístrate para rentar más rápido.</p>
        </div>

        <div asp-validation-summary="ModelOnly" class="form-alert"></div>

        <form asp-action="Register" method="post" novalidate>
            <div class="mb-3">
                <label asp-for="Username" class="form-label">Nombre de usuario</label>
                <input asp-for="Username" class="form-control" placeholder="Elige un usuario" autocomplete="username" />
                <span asp-validation-for="Username" class="field-error"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Correo electrónico</label>
                <input asp-for="Email" class="form-control" placeholder="tucorreo@ejemplo.com" autocomplete="email" />
                <span asp-validation-for="Email" class="field-error"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">Contraseña</label>
                <div class="password-field">
                    <input asp-for="Password" class="form-control" placeholder="Mínimo 8 caracteres" autocomplete="new-password" />
                    <button type="button" class="toggle-password" data-toggle-password="#Password" aria-label="Mostrar u ocultar contraseña">Mostrar</button>
                </div>
                <div class="strength" id="strength" data-nivel="0" aria-live="polite">
                    <div class="strength-bars"><span></span><span></span><span></span><span></span></div>
                    <small id="strength-label">Usa 8 o más caracteres, mayúsculas, números y símbolos.</small>
                </div>
                <span asp-validation-for="Password" class="field-error"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label">Confirmar contraseña</label>
                <div class="password-field">
                    <input asp-for="ConfirmPassword" class="form-control" placeholder="Repite tu contraseña" autocomplete="new-password" />
                    <button type="button" class="toggle-password" data-toggle-password="#ConfirmPassword" aria-label="Mostrar u ocultar contraseña">Mostrar</button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="field-error"></span>
            </div>

            <button type="submit" class="btn btn-snake w-100">Crear cuenta <span aria-hidden="true">→</span></button>
        </form>

        <p class="auth-switch">¿Ya tienes cuenta? <a asp-action="Login">Inicia sesión</a></p>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/auth.js" asp-append-version="true"></script>
}