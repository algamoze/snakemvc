@model snakemvc.Models.LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<section class="container auth-section">
    <div class="auth-card">
        <div class="auth-head">
            <span class="brand-icon" aria-hidden="true">S</span>
            <h1>Bienvenido de nuevo</h1>
            <p>Inicia sesión para continuar con tu reserva.</p>
        </div>

        @if (TempData["Mensaje"] is string mensaje)
        {
            <div class="form-alert form-alert-ok">@mensaje</div>
        }

        <div asp-validation-summary="ModelOnly" class="form-alert"></div>

        <form asp-action="Login" method="post" novalidate>
            <div class="mb-3">
                <label asp-for="Username" class="form-label">Usuario</label>
                <input asp-for="Username" class="form-control" placeholder="Tu usuario" autocomplete="username" />
                <span asp-validation-for="Username" class="field-error"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">Contraseña</label>
                <div class="password-field">
                    <input asp-for="Password" class="form-control" placeholder="Tu contraseña" autocomplete="current-password" />
                    <button type="button" class="toggle-password" data-toggle-password="#Password" aria-label="Mostrar u ocultar contraseña">Mostrar</button>
                </div>
                <span asp-validation-for="Password" class="field-error"></span>
            </div>

            <button type="submit" class="btn btn-snake w-100">Entrar <span aria-hidden="true">→</span></button>
        </form>

        <p class="auth-switch">¿No tienes cuenta? <a asp-action="Register">Regístrate</a></p>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/auth.js" asp-append-version="true"></script>
}