@{
    ViewData["Title"] = "Iniciar Sesión";
}
<div class="row justify-content-center">
    <div class="col-md-4">
        <h2 class="text-center">Iniciar Sesión</h2>
        @if (ViewBag.Error != null)
        {
            <p class="text-danger text-center">@ViewBag.Error</p>
        }
        <form method="post">
            <div class="form-group mb-3">
                <input type="text" name="username" placeholder="Usuario (ej. admin)" class="form-control" required />
            </div>
            <div class="form-group mb-3">
                <input type="password" name="password" placeholder="Contraseña (ej. 1234)" class="form-control" required />
            </div>
            <button type="submit" class="btn btn-primary w-100">Entrar</button>
        </form>
    </div>
</div>