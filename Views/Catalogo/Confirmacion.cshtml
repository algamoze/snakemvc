@using System.Globalization
@model snakemvc.Models.ReservaViewModel
@{
    var v = Model.Vehiculo!;
    ViewData["Title"] = "Reserva confirmada";
    var mx = CultureInfo.GetCultureInfo("es-MX");
}

<section class="container detalle-section">
    <div class="reserva-card confirmacion-card">
        <span class="eyebrow">¡LISTO!</span>
        <h1>Tu reserva está <span class="text-gradient">en camino.</span></h1>
        <p class="detalle-desc">Gracias, @Model.Nombre. Este es el comprobante de tu renta:</p>

        <div class="folio">Folio @Model.Folio</div>

        <div class="reserva-resumen resumen-lista">
            <div><span>Vehículo</span><strong>@v.Name</strong></div>
            <div><span>Recogida</span><strong>@Model.FechaInicio.ToString("dd 'de' MMMM yyyy", mx)</strong></div>
            <div><span>Devolución</span><strong>@Model.FechaFin.ToString("dd 'de' MMMM yyyy", mx)</strong></div>
            <div><span>Días</span><strong>@Model.Dias</strong></div>
            <div><span>Tarifa por día</span><strong>$@v.Price.ToString("N0", mx) MXN</strong></div>
            <div><span>Subtotal vehículo</span><strong>$@Model.Subtotal.ToString("N0", mx) MXN</strong></div>
            @if (Model.SillaBebe)
            {
                <div><span>Silla para bebé</span><strong>$@ReservaViewModel.PrecioSilla.ToString("N0", mx) / día</strong></div>
            }
            @if (Model.Gps)
            {
                <div><span>GPS</span><strong>$@ReservaViewModel.PrecioGps.ToString("N0", mx) / día</strong></div>
            }
            @if (Model.SeguroAmplio)
            {
                <div><span>Seguro amplio</span><strong>$@ReservaViewModel.PrecioSeguro.ToString("N0", mx) / día</strong></div>
            }
            @if (Model.TotalExtras > 0)
            {
                <div><span>Total extras</span><strong>$@Model.TotalExtras.ToString("N0", mx) MXN</strong></div>
            }
            <div class="resumen-total"><span>Total</span><strong>$@Model.Total.ToString("N0", mx) MXN</strong></div>
            <div><span>Contacto</span><strong>@Model.Email</strong></div>
        </div>

        <p class="comments-note">Por ahora la reserva no se guarda en una base de datos; es solo una confirmación en pantalla.</p>

        <div class="d-flex gap-2 flex-wrap mt-3 no-print">
            <button type="button" class="btn btn-snake" data-print>Imprimir o guardar PDF</button>
            <a asp-controller="Catalogo" asp-action="Catalogo" class="btn btn-ghost">Ver más autos</a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-ghost">Ir al inicio</a>
        </div>
    </div>
</section>